rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Field rules for every task, personal (/tasks) or shared
    // (/collaborativeLists/{listId}/tasks). dueTime is minutes after midnight.
    function validTaskData(data) {
      return data.keys().hasOnly([
          'ownerId', 'title', 'details', 'createdAt', 'dueDate', 'dueTime',
          'priority', 'category', 'isDone'
        ])
        && data.ownerId is string
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.details is string && data.details.size() <= 2000
        && data.createdAt is timestamp
        && (!('dueDate' in data) || data.dueDate == null || data.dueDate is timestamp)
        && (!('dueTime' in data) || data.dueTime == null
            || (data.dueTime is int && data.dueTime >= 0 && data.dueTime < 1440))
        && data.priority in ['low', 'medium', 'high']
        && data.category in ['school', 'personal', 'others']
        && data.isDone is bool;
    }

    match /collaborativeLists/{listId} {
      function listMember() {
        return request.auth != null
          && request.auth.uid in resource.data.memberIds;
      }

      // The 20-member cap matches maxListMembers in lib/core/limits.dart.
      function validList(data) {
        return data.keys().hasAll(['ownerId', 'name', 'memberIds', 'createdAt', 'updatedAt'])
          && data.keys().hasOnly(['ownerId', 'name', 'memberIds', 'createdAt', 'updatedAt'])
          && data.ownerId is string
          && data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.memberIds is list && data.memberIds.size() > 0 && data.memberIds.size() <= 20
          && data.memberIds.toSet().size() == data.memberIds.size()
          && data.ownerId in data.memberIds
          && data.createdAt is timestamp && data.updatedAt is timestamp;
      }

      allow create: if request.auth != null
        && listId == request.auth.uid
        && validList(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];
      allow get: if listMember()
        || (request.auth != null && listId == request.auth.uid
            && !exists(/databases/$(database)/documents/collaborativeLists/$(listId)));
      allow list: if listMember();
      // Only the owner may rename the list or change its member UIDs directly.
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && validList(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'memberIds', 'updatedAt']);
      allow delete: if false;

      match /tasks/{taskId} {
        function currentMember() {
          return request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/collaborativeLists/$(listId)).data.memberIds;
        }

        allow read, delete: if currentMember();
        allow create: if currentMember()
          && request.resource.data.ownerId == request.auth.uid
          && validTaskData(request.resource.data);
        allow update: if currentMember()
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt
          && validTaskData(request.resource.data);
      }
    }

    match /tasks/{taskId} {
      function signedIn() {
        return request.auth != null;
      }

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && validTaskData(request.resource.data);

      allow read: if signedIn()
        && resource.data.ownerId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && validTaskData(request.resource.data);

      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      function ownProfile() {
        return request.auth != null && request.auth.uid == userId;
      }

      function validProfile(data) {
        return data.keys().hasOnly([
            'uid',
            'email',
            'displayName',
            'createdAt',
            'updatedAt'
          ])
          && data.uid == userId
          && data.displayName is string
          && data.createdAt is timestamp
          && data.updatedAt is timestamp
          && (!('email' in data)
              || (data.email is string
                  && data.email == request.auth.token.get('email', null)));
      }

      allow create: if ownProfile()
        && validProfile(request.resource.data);

      allow read: if ownProfile();

      allow update: if ownProfile()
        && request.resource.data.uid == resource.data.uid
        && validProfile(request.resource.data)
        && (request.resource.data.get('email', null)
                == resource.data.get('email', null)
            || (request.auth.token.get('email_verified', false) == true
                && request.resource.data.get('email', null)
                    == request.auth.token.get('email', null)));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
